{
  "id": "unpack_breakdown",
  "name": "总-分原地展开（In-Place Unpack Diagram）",
  "description": "展示父节点先以实心卡出现，下一帧原地展开为虚线分组容器与子卡片，下方配无框核心结论。",
  "use_case": "适用于系统能力拆解、模块化架构或“先总后分”的递进讲解。",
  "scene": {
    "id": "unpack_scene",
    "title": "能力拆解：从核心入口到子模块原地展开",
    "subtitle": "节点原地展开为虚线分组，保持已有卡片与连线坐标纹丝不动",
    "layout": "canvas",
    "grid": { "columns": 12, "rows": 3, "gap": 20 },
    "regions": [
      { "id": "diag_zone", "col": 1, "row": 1, "col_span": 12, "row_span": 2 },
      { "id": "takeaway_zone", "col": 1, "row": 3, "col_span": 12, "row_span": 1 }
    ],
    "objects": [
      {
        "id": "unpack_flow",
        "kind": "diagram",
        "region": "diag_zone",
        "step": 1,
        "diagram": {
          "diagram_layout": "horizontal",
          "nodes": [
            {
              "id": "entry",
              "label": "核心能力入口",
              "variant": "primary"
            },
            {
              "id": "group_mod",
              "label": "数据与检索",
              "variant": "accent",
              "child_layout": "row",
              "children": [
                { "id": "sub_a", "label": "行情与财报", "variant": "primary" },
                { "id": "sub_b", "label": "联网检索", "variant": "primary" }
              ]
            }
          ],
          "edges": [
            { "id": "e1", "from": "entry", "to": "group_mod" }
          ]
        }
      },
      {
        "id": "unpack_takeaway",
        "kind": "callout",
        "region": "takeaway_zone",
        "step": 2,
        "surface": "borderless",
        "variant": "primary",
        "label": "先总后分：父节点原地拆解为虚线子系统",
        "note": "无需手动切格子摆孤立卡片，Magic Move 自动呈现容器展开效果"
      }
    ]
  }
}

    "layout": "canvas",
    "grid": { "columns": 12, "rows": 3, "gap": 20 },
    "regions": [
      { "id": "kpi_1", "col": 1, "row": 1, "col_span": 4, "row_span": 1 },
      { "id": "kpi_2", "col": 5, "row": 1, "col_span": 4, "row_span": 1 },
      { "id": "kpi_3", "col": 9, "row": 1, "col_span": 4, "row_span": 1 },
      { "id": "wf_zone", "col": 1, "row": 2, "col_span": 12, "row_span": 2 }
    ],
    "objects": [
      {
        "id": "kpi_start",
        "kind": "card",
        "region": "kpi_1",
        "step": 1,
        "variant": "primary",
        "metric": "100M",
        "label": "期初基准"
      },
      {
        "id": "kpi_delta",
        "kind": "card",
        "region": "kpi_2",
        "step": 1,
        "variant": "success",
        "metric": "+35M",
        "label": "核心净增"
      },
      {
        "id": "kpi_end",
        "kind": "card",
        "region": "kpi_3",
        "step": 1,
        "variant": "accent",
        "metric": "135M",
        "label": "期末总计"
      },
      {
        "id": "waterfall_chart",
        "kind": "chart",
        "region": "wf_zone",
        "step": 2,
        "chart": {
          "chart_type": "waterfall",
          "title": "驱动因子桥接拆解",
          "unit": "M",
          "categories": ["期初", "产品扩展", "定价提升", "客户流失", "期末合计"],
          "series": [{ "name": "贡献", "values": [100, 32, 18, -15, 135] }],
          "reveal": "by_category"
        }
      }
    ]
  }

{
  "id": "architecture_with_table",
  "name": "架构流程 + 基准对比表（Diagram + Table）",
  "description": "左侧展示多步内联流程/架构图，右侧展示结构化原生对比表格。",
  "use_case": "适用于技术方案讲解、系统链路与性能基准对照页。",
  "scene": {
    "id": "arch_table",
    "title": "架构升级与量化基准对照",
    "subtitle": "左侧梳理核心链路，右侧给出可编辑原生对比数据",
    "layout": "canvas",
    "grid": { "columns": 12, "rows": 1, "gap": 24 },
    "regions": [
      { "id": "flow_zone", "col": 1, "row": 1, "col_span": 7, "row_span": 1 },
      { "id": "table_zone", "col": 8, "row": 1, "col_span": 5, "row_span": 1 }
    ],
    "objects": [
      {
        "id": "pipeline_diagram",
        "kind": "diagram",
        "region": "flow_zone",
        "step": 1,
        "diagram": {
          "diagram_layout": "horizontal",
          "nodes": [
            { "id": "ingest", "label": "数据接入", "variant": "primary", "note": "校验与清洗" },
            { "id": "solve", "label": "约束求解", "variant": "accent", "note": "终态锚定" },
            { "id": "emit", "label": "原生输出", "variant": "success", "note": "零抖动编译" }
          ],
          "edges": [
            { "id": "e1", "from": "ingest", "to": "solve" },
            { "id": "e2", "from": "solve", "to": "emit" }
          ]
        }
      },
      {
        "id": "bench_table",
        "kind": "table",
        "region": "table_zone",
        "step": 2,
        "table": {
          "title": "方案对比",
          "headers": ["指标", "旧方案", "新方案"],
          "rows": [
            ["耗时", "420 ms", "85 ms"],
            ["稳定性", "78%", "99.9%"],
            ["维护成本", "高", "低"]
          ],
          "highlight_cols": [2],
          "reveal": "by_row"
        }
      }
    ]
  }
}

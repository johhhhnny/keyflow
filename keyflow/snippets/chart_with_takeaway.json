{
  "id": "chart_with_takeaway",
  "name": "左图右结论（Chart + Takeaway）",
  "description": "左侧 7 列展示核心数据柱状图（支持渐进），右侧 5 列展示核心结论 callout 与 1 枚关键支撑卡。",
  "use_case": "适用于用单一核心图表支撑明确商业或技术结论的页面。",
  "scene": {
    "id": "chart_takeaway",
    "title": "核心结论：数据趋势支撑关键判断",
    "subtitle": "左侧呈现量化趋势，右侧提炼唯一行动洞察",
    "layout": "canvas",
    "grid": { "columns": 12, "rows": 2, "gap": 24 },
    "regions": [
      { "id": "chart_zone", "col": 1, "row": 1, "col_span": 7, "row_span": 2 },
      { "id": "takeaway_top", "col": 8, "row": 1, "col_span": 5, "row_span": 1 },
      { "id": "takeaway_bot", "col": 8, "row": 2, "col_span": 5, "row_span": 1 }
    ],
    "objects": [
      {
        "id": "main_chart",
        "kind": "chart",
        "region": "chart_zone",
        "step": 1,
        "chart": {
          "chart_type": "column",
          "title": "核心指标对比",
          "unit": "%",
          "categories": ["Q1", "Q2", "Q3", "Q4"],
          "series": [{ "name": "本期", "values": [24, 38, 52, 68] }],
          "reveal": "by_category"
        }
      },
      {
        "id": "core_takeaway",
        "kind": "callout",
        "region": "takeaway_top",
        "step": 2,
        "variant": "accent",
        "badge": "INSIGHT",
        "label": "关键拐点出现在下半年",
        "sublabel": "Q4 较 Q1 提升近 3 倍，结构性优势已经确立"
      },
      {
        "id": "support_card",
        "kind": "card",
        "region": "takeaway_bot",
        "step": 3,
        "variant": "primary",
        "metric": "+44 pct",
        "label": "全年累计增幅",
        "sublabel": "需同步关注高基数下的边际放缓风险"
      }
    ]
  }
}

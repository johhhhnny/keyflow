{
  "title": "Freeform Compositional Canvas & Dual-Path Charts",
  "theme": "midnight_indigo",
  "use_templates": false,
  "palette": {
    "accent_fill_hex": "#2F5AA8",
    "series_colors": ["#F4C44E", "#4EA8DE", "#48C78E"]
  },
  "story_model": {
    "core_question": "How does KeyFlow combine freeform visual composition with Magic Move coordinate lock?",
    "claims": [
      {
        "id": "th_freeform",
        "type": "thesis",
        "claim": "Region-based composition lets heterogeneous cards, charts, tables, and inline diagrams share one locked grid.",
        "source_quote": "Freeform canvas partitions slides into non-overlapping regions while keeping object coordinates locked across frames."
      },
      {
        "id": "f_vector_speed",
        "type": "fact",
        "claim": "Progressive vector charts keep series slot widths constant across Magic Move transitions.",
        "source_quote": "By-series progressive column charts pre-allocate slots for all series so earlier bars never shift or narrow.",
        "metric_scope": "Keynote compile benchmark (ms)"
      },
      {
        "id": "ce_native_static",
        "type": "counter_evidence",
        "claim": "Static charts with reveal='whole' still compile as native Keynote Chart objects for data-sheet editing.",
        "source_quote": "Static charts preserve native Keynote Chart data grids while progressive builds emit pure Shape vectors."
      }
    ]
  },
  "scenes": [
    {
      "id": "canvas_mixed_dashboard",
      "title": "Freeform Grid: Vector Chart + Native Table",
      "subtitle": "Left series build preserves bar width; right table reveals row by row",
      "claim": "Progressive vector charts and native tables compose cleanly on one grid.",
      "metric_scope": "Keynote compile benchmark (ms)",
      "layout": "canvas",
      "grid": {"columns": 12, "rows": 1, "gap": 24},
      "regions": [
        {"id": "left_chart", "col": 1, "row": 1, "col_span": 6, "row_span": 1, "title": "Progressive Vector Bars", "frame": true},
        {"id": "right_stack", "col": 7, "row": 1, "col_span": 6, "row_span": 1, "arrange": "stack", "gap": 18, "title": "Native Table & Takeaway", "frame": true}
      ],
      "objects": [
        {
          "id": "compile_col",
          "kind": "chart",
          "region": "left_chart",
          "step": 1,
          "evidence_refs": ["f_vector_speed"],
          "note": "左图以纯矢量 Shape 分系列展开，第一系列柱宽在第二系列出现后保持不变。",
          "chart": {
            "chart_type": "column",
            "title": "Render Latency by Stage",
            "unit": "ms",
            "categories": ["Outline", "Pace", "Compile"],
            "series": [
              {"name": "Baseline", "values": [24, 38, 19]},
              {"name": "Vector Build", "values": [22, 31, 27]}
            ],
            "reveal": "by_series",
            "render_mode": "auto"
          }
        },
        {
          "id": "mode_tbl",
          "kind": "table",
          "region": "right_stack",
          "step": 2,
          "weight": 1.3,
          "evidence_refs": ["ce_native_static"],
          "note": "右上原生表格按行展开对比 Native Chart 与 Pure Vector Shape。",
          "table": {
            "title": "Dual Chart Paths",
            "headers": ["Mode", "Trigger", "Magic Move"],
            "rows": [
              ["Native Chart", "reveal='whole'", "Static editable sheet"],
              ["Vector Shape", "by_series / by_category", "Per-bar morph lock"]
            ],
            "highlight_cols": [2],
            "reveal": "by_row"
          }
        },
        {
          "id": "takeaway_callout",
          "kind": "callout",
          "region": "right_stack",
          "step": 3,
          "weight": 0.9,
          "variant": "accent",
          "badge": "THESIS",
          "label": "Locked Slot Width",
          "sublabel": "Zero cross-fade jump",
          "evidence_refs": ["th_freeform"],
          "note": "自由画布让矢量柱状图、原生表格和结论卡片协同呈现。"
        }
      ]
    },
    {
      "id": "canvas_diagram_and_donut",
      "title": "Progressive Inline Diagram + Native Donut",
      "subtitle": "Inline subgraphs unpack node by node while static charts keep native data",
      "claim": "Inline diagrams inherit coordinate-locked progressive pacing inside regions.",
      "layout": "canvas",
      "grid": {"columns": 12, "rows": 1, "gap": 24},
      "regions": [
        {"id": "donut_zone", "col": 1, "row": 1, "col_span": 5, "row_span": 1, "title": "Object Mix (Native Donut)", "frame": true},
        {"id": "diagram_zone", "col": 6, "row": 1, "col_span": 7, "row_span": 1, "title": "Progressive Pipeline", "frame": true}
      ],
      "objects": [
        {
          "id": "mix_donut",
          "kind": "chart",
          "region": "donut_zone",
          "step": 1,
          "evidence_refs": ["ce_native_static"],
          "note": "静态环图（reveal='whole'）保留原生 Keynote DonutChart 结构。",
          "chart": {
            "chart_type": "donut",
            "title": "Slide Composition Share",
            "categories": ["Shapes", "Textboxes", "Native Objects"],
            "series": [{"name": "Share", "values": [55, 30, 15]}],
            "reveal": "whole"
          }
        },
        {
          "id": "inline_pipeline",
          "kind": "diagram",
          "region": "diagram_zone",
          "step": 2,
          "evidence_refs": ["th_freeform"],
          "note": "右侧内嵌流程图按节点逐层展开。",
          "diagram": {
            "diagram_layout": "horizontal",
            "nodes": [
              {"id": "n1", "label": "Region Grid", "sublabel": "12-col layout", "note": "先确定 12 栏区域划分与槽位矩形。"},
              {"id": "n2", "label": "Step Pacer", "sublabel": "Sub-frame slice", "variant": "accent", "note": "再按对象步序与图内节点拆解子帧。"},
              {"id": "n3", "label": "Native .keyx", "sublabel": "Audit gated", "variant": "success", "note": "最后经严格审计编译输出原生 Keynote 文稿。"}
            ],
            "edges": [
              {"id": "e1", "from": "n1", "to": "n2"},
              {"id": "e2", "from": "n2", "to": "n3"}
            ]
          }
        }
      ]
    }
  ]
}

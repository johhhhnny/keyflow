    {
      "id": "temperature_matrix",
      "title": "Temperature 对 Softmax 的缩放作用",
      "layout": "comparison_matrix",
      "active_flow_node": "temp",
      "matrix": {
        "formula": "Softmax(zᵢ) = exp(zᵢ / T) / ∑ exp(zⱼ / T)",
        "columns": [
          {
            "id": "t_low",
            "caption": "T = 0.1",
            "action_banner": "调低 T 值",
            "action_subtext": "拉大差距    输出稳定",
            "takeaway": "低温稳定",
            "note": "T=0.1 时头部词“马克”概率飙升至 71%，长尾趋近 0%，输出高度确定。",
            "headers": ["zᵢ", "zᵢ/T", "Softmax(zᵢ)"],
            "rows": [
              { "chip": "马克", "values": ["4.2", "42", "71%"], "trend": "up" },
              { "chip": "科技", "values": ["4.1", "41", "26%"], "trend": "down" },
              { "chip": "AI", "values": ["3.9", "39", "4%"], "trend": "down" },
              { "chip": "自行车", "values": ["1.8", "18", "0%"], "trend": "down" },
              { "chip": "hello", "values": ["1.4", "14", "0%"], "trend": "down" }
            ]
          },
          {
            "id": "t_base",
            "caption": "T = 1",
            "is_baseline": true,
            "note": "T=1 为原始 Softmax 基准分布：马克 36%、科技 32%、AI 26%。",
            "headers": ["zᵢ", "zᵢ/T", "Softmax(zᵢ)"],
            "rows": [
              { "chip": "马克", "values": ["4.2", "4.2", "36%"] },
              { "chip": "科技", "values": ["4.1", "4.1", "32%"] },
              { "chip": "AI", "values": ["3.9", "3.9", "26%"] },
              { "chip": "自行车", "values": ["1.8", "1.8", "3%"] },
              { "chip": "hello", "values": ["1.4", "1.4", "2%"] }
            ]
          },
          {
            "id": "t_high",
            "caption": "T = 2",
            "action_banner": "调高 T 值",
            "action_subtext": "缩小差距    输出多样",
            "note": "T=2 时头部概率被压平，长尾词（自行车 9%、hello 7%）获得更多采样机会。",
            "headers": ["zᵢ", "zᵢ/T", "Softmax(zᵢ)"],
            "rows": [
              { "chip": "马克", "values": ["4.2", "2.1", "30%"], "trend": "down" },
              { "chip": "科技", "values": ["4.1", "2.05", "28%"], "trend": "down" },
              { "chip": "AI", "values": ["3.9", "1.95", "26%"], "trend": "neutral" },
              { "chip": "自行车", "values": ["1.8", "0.9", "9%"], "trend": "up" },
              { "chip": "hello", "values": ["1.4", "0.7", "7%"], "trend": "up" }
            ]
          }
        ]
      }
    },

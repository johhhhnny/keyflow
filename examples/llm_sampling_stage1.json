          { "id": "tech", "label": "科技", "value": 32, "note": "第二候选词“科技”占 32%（累计 36–68%）。" },
          { "id": "ai", "label": "AI", "value": 26, "note": "第三候选词“AI”占 26%（累计 68–94%）。" },
          { "id": "bike", "label": "自行车", "value": 3, "note": "第四候选词“自行车”占 3%（累计 94–97%）。" },
